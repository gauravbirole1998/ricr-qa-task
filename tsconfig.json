{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    // "moduleResolution": "node",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["jest", "node"]
  },
  "include": ["src", "e2e", "playwright.config.ts"]
}
